{
  "name": "patra",
  "version": "0.1.0",
  "private": true,
  "description": "Patra [pa.t̪ra] means Paper in Sanskrit. A light weight blogging/notes viewer which displays the markdown content.",
  "main": "dist/scripts/build.js",
  "bin": {
    "patra": "dist/scripts/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "template.html"
  ],
  "scripts": {
    "build": "ts-node scripts/cli.ts build",
    "serve": "ts-node scripts/cli.ts serve",
    "start": "npm run build && npm run serve",
    "compile": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "glob": "^14.0.6",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamoli/Patra.git"
  }
}
